# Supabase project → Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# WhatsApp number that receives booking and artist enquiries (country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919274739763

# Extra hosts that serve the artist portal at their root (comma-separated), on top of any
# artists.* host. E.g. a Vercel domain added to this project: aod-artists.vercel.app
ARTISTS_HOSTS=

# Full address of the customer site, used by the artist portal's "Back to the main site" link
# (needed on the artists domain, where "/" is the portal). E.g. https://artistsondemand.vercel.app
NEXT_PUBLIC_SITE_URL=
