# Supabase project → Settings → API keys. With the URL and publishable key set, the site saves
# forms to the database and uses real sign-in codes; without them it runs as the preview.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (same page, "Secret keys"). Server only: never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Emails (resend.com): an API key, and a sender on the domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=AOD <noreply@aod.co.in>
# Where team notifications go (comma-separated). Defaults to the site's email.
TEAM_EMAIL=

# The team's orders spreadsheet (Google Sheets API, through a service account).
# ORDERS_SHEET_ID is the long id in the sheet's address: docs.google.com/spreadsheets/d/<id>/edit
ORDERS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The service account's private key, on one line with 
 for line breaks, in double quotes.
GOOGLE_PRIVATE_KEY=

# Protects /api/jobs/retry, which retries sheet rows and emails that failed. Any long random string.
CRON_SECRET=

# WhatsApp number that receives booking and artist enquiries (country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919274739763

# Extra hosts that serve a section at their root (comma-separated), on top of any artists.*,
# pay.*, admin.* or resolve.* host. E.g. Vercel domains added to this project:
ARTISTS_HOSTS=   # aod-artists.vercel.app
PAY_HOSTS=       # aod-pay.vercel.app
ADMIN_HOSTS=     # aod-admin.vercel.app
RESOLVE_HOSTS=   # aod-resolve.vercel.app

# UPI ID (VPA) and account name the payment page pays. Use a business/merchant UPI ID.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Artists on Demand

# Optional bank transfer details shown on the payment page (shown only if number and IFSC are set)
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_IFSC=
NEXT_PUBLIC_BANK_NAME=

# Optional: full address of the payment page, used in payment links made in the admin panel
# (needed when the admin runs on its own domain). E.g. https://aod-pay.vercel.app
NEXT_PUBLIC_PAY_URL=

# Where the hero video and its posters are served from (see src/components/home/HeroVideo.tsx).
# Empty = public/media/ on this site. Set it to a storage bucket or CDN folder holding the same
# file names to serve them from there, e.g. https://<project>.supabase.co/storage/v1/object/public/media
NEXT_PUBLIC_MEDIA_URL=

# Full address of the customer site, used by the artist portal's "Back to the main site" link
# (needed on the artists domain, where "/" is the portal). E.g. https://artistsondemand.vercel.app
NEXT_PUBLIC_SITE_URL=
