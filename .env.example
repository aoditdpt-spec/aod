# Supabase project → Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# WhatsApp number that receives booking and artist enquiries (country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919274739763

# Extra hosts that serve a section at their root (comma-separated), on top of any artists.*,
# pay.* or admin.* host. E.g. Vercel domains added to this project:
ARTISTS_HOSTS=   # aod-artists.vercel.app
PAY_HOSTS=       # aod-pay.vercel.app
ADMIN_HOSTS=     # aod-admin.vercel.app

# UPI ID (VPA) and account name the payment page pays. Use a business/merchant UPI ID.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=Artists on Demand

# Optional bank transfer details shown on the payment page (shown only if number and IFSC are set)
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_IFSC=
NEXT_PUBLIC_BANK_NAME=

# Optional: full address of the payment page, used in payment links made in the admin panel
# (needed when the admin runs on its own domain). E.g. https://aod-pay.vercel.app
NEXT_PUBLIC_PAY_URL=

# Full address of the customer site, used by the artist portal's "Back to the main site" link
# (needed on the artists domain, where "/" is the portal). E.g. https://artistsondemand.vercel.app
NEXT_PUBLIC_SITE_URL=
